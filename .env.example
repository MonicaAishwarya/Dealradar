# DealRadar Intelligence OS — Environment Variables
# Copy this file to backend/.env and fill in values for your environment.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (development — file is created automatically)
DATABASE_URL=sqlite:///./dealradar.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@host:5432/dealradar

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# For production, set to your deployed frontend URL:
# ALLOWED_ORIGINS=https://dealradar.vercel.app

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=DealRadar Intelligence OS
APP_VERSION=1.0.0
DEBUG=false

# ── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Risk thresholds (0-100 scale) ─────────────────────────────────────────
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60
RISK_HIGH_MAX=85

# ── Frontend (set in frontend/.env.local, NOT backend) ────────────────────
# VITE_API_URL=https://your-backend.onrender.com/api
